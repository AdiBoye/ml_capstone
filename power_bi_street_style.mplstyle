# Power BI Style Sheet for Matplotlib/Seaborn

# Figure Layout
figure.figsize: 10, 6
figure.facecolor: white
figure.titlesize: 18
figure.titleweight: bold
figure.dpi: 100

# Axes
axes.facecolor: white
axes.edgecolor: #333333
axes.linewidth: 0.8
axes.grid: True
axes.titlesize: 14
axes.titleweight: bold
axes.titlepad: 12
axes.labelsize: 11
axes.labelweight: normal
axes.axisbelow: True
axes.prop_cycle: cycler('color', ['01B8AA', '374649', 'FD625E', 'F2C80F', '5F6B6D', '8AD4EB', 'FE9666', 'A66999'])

# Spines (Remove top and right for cleaner look)
axes.spines.top: False
axes.spines.right: False
axes.spines.bottom: True
axes.spines.left: True

# Grid
grid.color: #E6E6E6
grid.linestyle: -
grid.linewidth: 0.6
grid.alpha: 0.8

# Text / Font
text.color: #333333
font.family: sans-serif
# Segoe UI is the standard Power BI font. Falls back to Arial if not found.
font.sans-serif: Segoe UI, Arial, Helvetica, DejaVu Sans, Bitstream Vera Sans, sans-serif
font.size: 11

# Ticks
xtick.direction: out
ytick.direction: out
xtick.color: #333333
ytick.color: #333333
xtick.labelsize: 10
ytick.labelsize: 10
xtick.major.width: 0.8
ytick.major.width: 0.8
xtick.major.pad: 5
ytick.major.pad: 5

# Legend
legend.frameon: False
legend.numpoints: 1
legend.scatterpoints: 1
legend.fontsize: 10
legend.title_fontsize: 11